[flake8]
exclude =
    .venv,
    .git,
    node_modules,
    __pycache__,
    .pytest_cache,
    .mypy_cache,
    .ruff_cache,
    .tox,
    .nox,
    build,
    dist,
    *.egg-info,
    migrations
extend-ignore =
    WPS110,
    WPS111,
    WPS201,
    WPS202,
    WPS204,
    WPS210,
    WPS214,
    WPS219,
    WPS221,
    WPS225,
    WPS226,
    WPS229,
    WPS231,
    WPS235,
    WPS237,
    WPS238,
    WPS300,
    WPS335,
    WPS338,
    WPS358,
    WPS407,
    WPS410,
    WPS411,
    WPS412,
    WPS420,
    WPS430,
    WPS432,
    WPS441,
    WPS458,
    WPS476,
    WPS501,
    WPS504,
    WPS505,
    WPS509,
    WPS518,
    WPS602,
    WPS604
