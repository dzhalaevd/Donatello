{
  "uid": "datingbot-docker",
  "title": "Docker / Containers Overview",
  "tags": ["datingbot", "docker"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Running Containers",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "count(container_last_seen{name!=\"\"})", "refId": "A"}],
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0}
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "CPU by Container",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "topk(10, sum by (name) (rate(container_cpu_usage_seconds_total{name!=\"\"}[5m])))", "legendFormat": "{{name}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "cores"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4}
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Memory by Container",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "topk(10, sum by (name) (container_memory_working_set_bytes{name!=\"\"}))", "legendFormat": "{{name}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4}
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Network Receive",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "topk(10, sum by (name) (rate(container_network_receive_bytes_total{name!=\"\"}[5m])))", "legendFormat": "{{name}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "Bps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Network Transmit",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "topk(10, sum by (name) (rate(container_network_transmit_bytes_total{name!=\"\"}[5m])))", "legendFormat": "{{name}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "Bps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12}
    },
    {
      "id": 6,
      "type": "logs",
      "title": "Recent Container Logs",
      "datasource": {"type": "loki", "uid": "loki"},
      "targets": [{"expr": "{environment=\"dev\"}", "refId": "A"}],
      "gridPos": {"h": 9, "w": 24, "x": 0, "y": 20}
    }
  ]
}
